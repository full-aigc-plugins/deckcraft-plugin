{
  "name": "deckcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "Pitch decks, weekly reports, training material, data stories and option comparisons. Masters, layouts and speaker notes stay editable after export.",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "DeckCraft · Presentations",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "deckcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "DeckCraft · Presentations"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "DeckCraft · Presentations",
          "zh-CN": "DeckCraft · 演示文稿"
        },
        "icon": "presentation",
        "server": "deckcraft-editor",
        "resourceUri": "ui://deckcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
